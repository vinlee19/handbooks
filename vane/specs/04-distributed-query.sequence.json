  "cards": [
    {
      "dot": "cyan",
      "title": "控制流",
      "items": [
        "Driver Actor 是集群里唯一的调度大脑，FTE 自建准入/租约/压力记账",
        "碎片模板先注册到 Worker，任务按窗口批量提交",
        "连接快照让每个 Worker 重建出与 Driver 一致的 DuckDB 实例"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据流",
      "items": [
        "shuffle 先写节点本地磁盘 IPC 文件，再用 Flight DoGet 跨节点拉取",
        "Join 按策略广播或哈希重分区；非等值/ASOF/cross 先收拢再执行",
        "最终分区进 Plasma 对象存储，用户侧拿到零拷贝 PyArrow 表"
      ]
    },
    {
      "dot": "rose",
      "title": "容错",
      "items": [
        "任务失败按 attempt 重试，输入从 FteSplitQueue 重放",
        "支持投机执行（speculative）与撤销（revocation）",
        "Flight 服务带 server_epoch 围栏，陈旧 ticket 直接失效"
      ]
    }
  ]
