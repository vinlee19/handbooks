  "cards": [
    {
      "dot": "cyan",
      "title": "双语言边界",
      "items": [
        "调用方：rel.map_batches(fn) 或 vane.ai.embed / prompt 附加表达式",
        "绑定层封装为 _VaneUDFMapBatchesExpression，规划期降为 LOGICAL_UDF_PROJECT",
        "执行期引擎线程释放 GIL，Python 回调只发生在 UDF 边界"
      ]
    },
    {
      "dot": "violet",
      "title": "数据过界",
      "items": [
        "分发器即 PhysicalUdfInOut + GlobalPythonDispatcher，按批提交",
        "函数对象经 cloudpickle 下发到 Ray actor / subprocess",
        "批数据以 pyarrow.Table 进出，背压由提交槽位与 in-flight 上限控制"
      ]
    },
    {
      "dot": "rose",
      "title": "错误与降级",
      "items": [
        "on_error=raise 时异常经 PythonExceptionHandling 转译回调用栈",
        "on_error=ignore 时该行置 NULL 并记录脱敏日志",
        "vLLM / SGLang 提供方不走 Python 回路，直接降为原生 VLLM_PROJECT 算子"
      ]
    }
  ]
}