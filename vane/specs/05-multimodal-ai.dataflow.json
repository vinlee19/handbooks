  "flows": [
    {
      "id": "f_video",
      "from": "video_src",
      "to": "ds_scan",
      "label": "帧批次",
      "variant": "emphasis",
      "classification": "约 10MiB 分区"
    },
    {
      "id": "f_files",
      "from": "files",
      "to": "ds_scan",
      "label": "列数据"
    },
    {
      "id": "f_scan_udf",
      "from": "ds_scan",
      "to": "udf_op",
      "label": "Arrow 批",
      "variant": "emphasis"
    },
    {
      "id": "f_files_vllm",
      "from": "files",
      "to": "vllm_op",
      "label": "文本/图像列"
    },
    {
      "id": "f_udf_prov",
      "from": "udf_op",
      "to": "providers",
      "label": "embed_text",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "f_vllm_model",
      "from": "vllm_op",
      "to": "models",
      "label": "Submit 批",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "f_prov_out",
      "from": "providers",
      "to": "embed_out",
      "label": "向量",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "f_model_resp",
      "from": "models",
      "to": "resp",
      "label": "生成文本"
    },
    {
      "id": "f_embed_sink",
      "from": "embed_out",
      "to": "sink",
      "label": "分布式 upsert",
      "variant": "dashed",
      "route": "vertical-channel",
      "channelX": 1052,
      "labelAt": [
        1052,
        271
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "多模态即列",
      "items": [
        "没有 IMAGE/VIDEO 类型：视频帧是 TENSOR(UTINYINT,[h,w,3]) 列",
        "文件引用是 FILE 结构体（URL/MIME/大小/校验和），免凭证传输",
        "decord 源带内存水位背压，约 10MiB 一个流式分区"
      ]
    },
    {
      "dot": "violet",
      "title": "两条推理路径",
      "items": [
        "API 路径：ai.embed/prompt → 批 UDF → Provider SDK（重试/分块/限流）",
        "自托管路径：provider=vllm/sglang 降为原生算子，C++ 侧 prefix 分桶",
        "批以 Arrow Table 过界，GPU actor 池常驻避免冷启动"
      ]
    },
    {
      "dot": "rose",
      "title": "工程化保障",
      "items": [
        "on_error=ignore 时坏行置 NULL，不中断整条管道",
        "结构化输出按 JSON Schema 编译校验后再落列",
        "embedding 经 DataSink upsert 进向量库，交付语义由 sink 定义"
      ]
    }
  ]
}