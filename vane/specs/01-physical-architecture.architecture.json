  "cards": [
    {
      "dot": "cyan",
      "title": "物理边界",
      "items": [
        "Driver 以库形态内嵌在用户进程里，没有独立服务",
        "Ray 集群内只有一个命名 Driver Actor，钉在 head 节点",
        "每个 Ray 节点恰好一个常驻 Worker Actor（max_concurrency 256）"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据平面",
      "items": [
        "全链路 Arrow RecordBatch，经 C 数据接口跨语言传递",
        "shuffle 先落本地磁盘 IPC 文件，再用 Flight DoGet 拉取",
        "最终结果分区经 ray.put 进 Plasma，由 Driver 租约收集"
      ]
    },
    {
      "dot": "rose",
      "title": "控制平面",
      "items": [
        "FTE 用租约 / 准入泵 / 压力记账自建调度，不走 Ray 原生任务队列",
        "Worker 依据连接快照重建精确的 DuckDB DatabaseInstance",
        "Flight 无 TLS、无鉴权，靠可信集群网络隔离；UDF/LLM 走独立 Actor 池"
      ]
    }
  ]
}