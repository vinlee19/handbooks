  "cards": [
    {
      "dot": "cyan",
      "title": "一次性语义",
      "items": [
        "PrepareDistributedWrite 在调度前恰好执行一次（#703 核心增量）",
        "FinalizeDistributedWrite 在 Vane 协调者事务内恰好执行一次",
        "affected-row 必须与信封总数一致，否则拒绝提交"
      ]
    },
    {
      "dot": "amber",
      "title": "中止窗口",
      "items": [
        "abort 仅在 prepare 已启动且 finalize 未启动时允许",
        "worker 已开跑时，abort 必须等 quiesce 屏障成功后才执行",
        "屏障失败则保留输出与已 prepare 的状态，不强行回滚"
      ]
    },
    {
      "dot": "rose",
      "title": "不可知终态",
      "items": [
        "finalize 启动后任何失败都不再 abort、不删工件、不重试",
        "catalog 提交结果未知时标记 outcome_unknown=true",
        "扩展侧须把工件写得可幂等对账（如不可变路径 + 统计 DTO）"
      ]
    }
  ]
}