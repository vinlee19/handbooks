  "cards": [
    {
      "dot": "emerald",
      "title": "主路径不变式",
      "items": [
        "Relation 操作只追加代数树节点，任何 fetch 才触发执行",
        "SELECT 且无参数时 sql() 返回惰性 QueryRelation，否则物化",
        "结果一律以 Arrow C 数据接口过界，供 PyArrow / pandas / torch 消费"
      ]
    },
    {
      "dot": "violet",
      "title": "Vane 对引擎的定制点",
      "items": [
        "优化器里挂入 UDF / VLLM Project Rewriter，把 AI 调用变成计划算子",
        "新增物理算子：STREAMING_UDF · VLLM_PROJECT · REPARTITION · LOCAL_EXCHANGE",
        "类型系统新增 FILE（URL/校验和结构体）与 TENSOR（定形张量）"
      ]
    },
    {
      "dot": "rose",
      "title": "一次编写，三种执行",
      "items": [
        "VANE_RUNNER 环境变量在 C++ 侧分叉，Relation 代码零改动",
        "Runner 按 DatabaseInstance 缓存，连接关闭时通知清理",
        "本地 FTE 与 Ray 跑的是同一份定位后的分布式物理计划"
      ]
    }
  ]
