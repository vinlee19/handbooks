  "cards": [
    {
      "dot": "emerald",
      "title": "追加永不冲突",
      "items": [
        "FastAppend / MergeAppend 没有冲突校验：并发 append 全部成功",
        "冲突只在显式声明的操作间爆发：Overwrite / RowDelta / DeleteFiles",
        "校验范围 = 起始快照之后的 APPEND/OVERWRITE 清单 + 冲突检测过滤"
      ]
    },
    {
      "dot": "violet",
      "title": "REST 的 assert 体系",
      "items": [
        "客户端发 requirements（AssertRefSnapshotID 等）+ updates",
        "服务端校验失败返回 409 → 客户端重试；500/502/504 视为状态未知",
        "多表事务走 /transactions/commit，一个请求带多张表的变更"
      ]
    },
    {
      "dot": "rose",
      "title": "垃圾清理",
      "items": [
        "重试前 cleanUncommitted 删除失败尝试的 manifest-list",
        "CommitStateUnknown 不清理不重试，先复核目录里的真实状态",
        "孤儿文件交给 RemoveOrphanFiles（默认 3 天宽限）"
      ]
    }
  ]
