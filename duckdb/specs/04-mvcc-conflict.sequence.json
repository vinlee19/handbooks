    { "dot": "cyan", "title": "无锁读", "items": [
      "读操作拿 start_time 当快照，按版本链判断可见性",
      "没有任何读锁：OLAP 查询之间永远不互相阻塞",
      "catalog 也走同一套版本链（CatalogSet 时间戳）"
    ] },
    { "dot": "rose", "title": "乐观写冲突", "items": [
