  "cards": [
    {
      "dot": "cyan",
      "title": "推送式执行",
      "items": [
        "一条流水线 = 1 个 source → N 个中间算子 → 1 个 sink",
        "PipelineExecutor 每次调用最多推 50 个 chunk，让出线程调度",
        "算子返回 HAVE_MORE_OUTPUT 时压栈重入（如 join 逐批吐匹配）"
      ]
    },
    {
      "dot": "violet",
      "title": "事件 DAG",
      "items": [
        "每条流水线挂 5 个事件：Initialize → Run → PrepareFinish → Finish → Complete",
        "Join 构建顺序靠事件依赖保证：全部 Combine 后统一 PrepareFinalize",
        "临时内存管理器（TMM）在该阶段决定算子内存预算，超了就落盘"
      ]
    },
    {
      "dot": "rose",
      "title": "背压与顺序",
      "items": [
        "source/sink BLOCKED 时任务挂起，InterruptState 回调后重新入队",
        "batch index 保证 sink 侧保序 flush（BatchInsert / CopyToFile / Order）",
        "BatchMemoryManager 超内存水位即冻结高批次任务"
      ]
    }
  ]
}