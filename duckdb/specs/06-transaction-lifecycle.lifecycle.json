      "labelAt": [
        180,
        262
      ]
    },
    {
      "id": "t_cf",
      "from": "running",
      "to": "conflict",
      "label": "更新撞版本链",
      "variant": "security",
      "labelAt": [
        325,
        350
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主路径五步",
      "items": [
        "BEGIN：分配 start_time（读快照）与 transaction_id（写版本）",
        "写操作进 UndoBuffer + 本地存储，基表只挂版本链",
        "提交把版本号从 transaction_id 改写为 commit_id，读快照语义就此定型"
      ]
    },
    {
      "dot": "amber",
      "title": "回滚即逆放",
      "items": [
        "UndoBuffer 逆序回放即可完全恢复原状",
        "事务本地行组（LocalStorage）直接丢弃",
        "catalog 变更同样走 undo（CatalogEntry 版本链 Undo）"
      ]
    },
    {
      "dot": "rose",
      "title": "乐观并发",
      "items": [
        "先到先得：同一行第二个更新者立即收到冲突异常",
        "没有任何等待或死锁检测，OLAP 场景冲突天然稀少",
        "undo 空间等最老活跃事务离开后才真正释放（Cleanup）"
      ]
    }
  ]
}