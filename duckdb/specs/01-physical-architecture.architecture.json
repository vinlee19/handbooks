  "cards": [
    {
      "dot": "cyan",
      "title": "嵌入式形态",
      "items": [
        "没有服务端：引擎以库链接进宿主进程，CLI/Swift/Julia 直接进程内调用",
        "Python/R/JDBC/ODBC 客户端已拆到独立仓库，经 C API 或替换扫描接入",
        "默认配置就地取材：内存上限 80% 系统可用内存，线程数=物理核"
      ]
    },
    {
      "dot": "emerald",
      "title": "单文件持久化",
      "items": [
        "文件头 magic DUCK + 双 DatabaseHeader 交替写，崩溃安全",
        "256KB 块分配 + 空闲链表；RowGroup 122880 行，列段独立压缩",
        "压缩算法全家桶：Bitpacking/Dictionary/FSST/ALP/Chimp/Roaring/ZSTD"
      ]
    },
    {
      "dot": "rose",
      "title": "扩展信任链",
      "items": [
        "512 字节 footer + 256 字节 RSA 签名，SHA-256 分段校验",
        "ABI 三档：CPP 精确匹配 / C_STRUCT 前向兼容 / UNSTABLE 一对一",
        "自动加载白名单限 scanner 类扩展；安装需 SET allow_unsigned_extensions 才能绕过"
      ]
    }
  ]
}