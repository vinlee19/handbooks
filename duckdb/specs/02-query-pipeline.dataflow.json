  "cards": [
    {
      "dot": "emerald",
      "title": "前端即 PG 语法",
      "items": [
        "libpg_query（PostgreSQL 语法）解析，Transformer 转成 SQLStatement",
        "未知语句交给 ParserExtension，扩展可接管自己的语法",
        "绑定失败可触发替换扫描：SELECT * FROM 'data.csv' 直接可查"
      ]
    },
    {
      "dot": "violet",
      "title": "有序优化器",
      "items": [
        "35 遍优化按固定顺序执行，每遍后做列绑定校验",
        "过滤下推 → 连接序(DPhyp) → 统计传播 → 压缩物化 各司其职",
        "关联子查询先展平成 DelimJoin，再由 Deliminator 清理冗余"
      ]
    },
    {
      "dot": "rose",
      "title": "物理化",
      "items": [
        "等值 Join → 哈希 Join，范围 Join → IEJoin/MergeJoin",
        "聚合按位宽选完美哈希或基数分区哈希表",
        "ORDER BY+LIMIT 自动改写 TopN；统计可触发压缩物化"
      ]
    }
  ]
}